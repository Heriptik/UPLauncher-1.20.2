<div id="loginContainer" style="display: none;">
    <div id="loginContent">
        <form id="loginForm">
            <span id="loginTitle"><%- lang('login.loginTitle') %></span>
            <span id="loginSubheader"><%- lang('login.loginSubheader') %></span>
            <div class="loginFieldContainer">
                <label class="loginFieldLabel" for="loginUsername"><%- lang('login.loginUsernameLabel') %></label>
                <input id="loginUsername" class="loginField" type="text" maxlength="16" spellcheck="false" autocomplete="off" placeholder="<%- lang('login.loginUsernamePlaceholder') %>"/>
                <span class="loginErrorSpan" id="loginEmailError"><%- lang('login.loginEmailError') %></span>
            </div>
            <!-- Unused in offline mode. Kept because login.js references these elements. -->
            <div style="display: none;">
                <span class="loginErrorSpan" id="loginPasswordError"><%- lang('login.loginPasswordError') %></span>
                <input id="loginPassword" class="loginField" type="password" placeholder="<%- lang('login.loginPasswordPlaceholder') %>"/>
                <label id="checkmarkContainer">
                    <input id="loginRememberOption" type="checkbox" checked>
                </label>
            </div>
            <button id="loginButton" disabled>
                <div id="loginButtonContent">
                    <%- lang('login.loginButtonText') %>
                    <div class="circle-loader">
                        <div class="checkmark draw"></div>
                    </div>
                </div>
            </button>
            <div id="loginCancelContainer" style="display: none;">
                <button id="loginCancelButton" type="button"><%- lang('login.loginCancelText') %></button>
            </div>
            <div id="loginDisclaimer">
                <p class="loginDisclaimerText"><%- lang('login.loginDisclaimer1') %></p>
                <p class="loginDisclaimerText"><%- lang('login.loginDisclaimer2') %></p>
            </div>
        </form>
    </div>
    <script src="./assets/js/scripts/login.js"></script>
</div>
