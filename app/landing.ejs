<div id="landingContainer" style="display: none;">

    <!-- Logo -->
    <div id="landingLogo" aria-hidden="true">
        <div class="ulLogo">
            <img src="assets/images/logo.png" alt=""/>
            <div class="ulLogoShine"></div>
            <svg class="ulLogoSpark" viewBox="0 0 24 24"><path d="M12 0C12.8 8 16 11.2 24 12C16 12.8 12.8 16 12 24C11.2 16 8 12.8 0 12C8 11.2 11.2 8 12 0Z"/></svg>
            <svg class="ulLogoSpark" viewBox="0 0 24 24"><path d="M12 0C12.8 8 16 11.2 24 12C16 12.8 12.8 16 12 24C11.2 16 8 12.8 0 12C8 11.2 11.2 8 12 0Z"/></svg>
            <svg class="ulLogoSpark" viewBox="0 0 24 24"><path d="M12 0C12.8 8 16 11.2 24 12C16 12.8 12.8 16 12 24C11.2 16 8 12.8 0 12C8 11.2 11.2 8 12 0Z"/></svg>
            <svg class="ulLogoSpark" viewBox="0 0 24 24"><path d="M12 0C12.8 8 16 11.2 24 12C16 12.8 12.8 16 12 24C11.2 16 8 12.8 0 12C8 11.2 11.2 8 12 0Z"/></svg>
            <svg class="ulLogoSpark" viewBox="0 0 24 24"><path d="M12 0C12.8 8 16 11.2 24 12C16 12.8 12.8 16 12 24C11.2 16 8 12.8 0 12C8 11.2 11.2 8 12 0Z"/></svg>
            <svg class="ulLogoSpark" viewBox="0 0 24 24"><path d="M12 0C12.8 8 16 11.2 24 12C16 12.8 12.8 16 12 24C11.2 16 8 12.8 0 12C8 11.2 11.2 8 12 0Z"/></svg>
            <svg class="ulLogoSpark" viewBox="0 0 24 24"><path d="M12 0C12.8 8 16 11.2 24 12C16 12.8 12.8 16 12 24C11.2 16 8 12.8 0 12C8 11.2 11.2 8 12 0Z"/></svg>
        </div>
    </div>

    <!-- News card -->
    <button id="newsButton">
        <div id="newsButtonAlert" style="display: none;"><%- lang('landing.newsNewBadge') %></div>
        <span id="newsCardImage"></span>
        <span id="newsCardBody">
            <span id="newsButtonText"><%- lang('landing.newsButton') %></span>
            <span id="newsCardTitle"><%- lang('landing.newsErrorLoadSpan') %></span>
            <span id="newsCardMore"><%- lang('landing.newsReadMore') %></span>
        </span>
    </button>

    <!-- Launcher update pill -->
    <button id="updateIconContainer" style="display: none;">
        <svg id="updateIconSVG" viewBox="0 0 512 512" aria-hidden="true"><path d="M288 32c0-17.7-14.3-32-32-32s-32 14.3-32 32V274.7l-73.4-73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l128 128c12.5 12.5 32.8 12.5 45.3 0l128-128c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L288 274.7V32zM64 352c-35.3 0-64 28.7-64 64v32c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V416c0-35.3-28.7-64-64-64H346.5l-45.3 45.3c-25 25-65.5 25-90.5 0L165.5 352H64zm368 56a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"/></svg>
        <span id="updateTooltip"><%- lang('landing.updateAvailableTooltip') %></span>
    </button>

    <!-- Floating dock -->
    <div id="landingDock">
        <button id="avatarOverlay">
            <span id="avatarContainer"></span>
            <span id="user_content">
                <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                <span id="user_subtext"><%- lang('landing.usernameEditButton') %></span>
            </span>
        </button>
        <span class="dockDivider" aria-hidden="true"></span>
        <button id="serverStatusButton">
            <span id="serverStatusDot" aria-hidden="true"></span>
            <span id="server_status_wrapper">
                <span id="landingPlayerLabel"><%- lang('landing.serverStatus') %></span>
                <span id="player_count"><%- lang('landing.serverStatusPlaceholder') %></span>
            </span>
        </button>
        <div id="launchStatus">
            <span id="launch_ready"><%- lang('landing.launchReady') %></span>
            <div id="launch_details">
                <div id="launch_details_top">
                    <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
                    <span id="launch_progress_label">0%</span>
                </div>
                <progress id="launch_progress" value="0" max="100"></progress>
            </div>
        </div>
        <div id="launch_content">
            <button id="settingsMediaButton" class="ulTip ulTipUp" data-tip="<%- lang('landing.settingsTooltip') %>" aria-label="<%- lang('landing.settingsTooltip') %>">
                <svg id="settingsSVG" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            <button id="launch_button" class="ulTip ulTipUp">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z"/></svg>
                <span><%- lang('landing.launchButton') %></span>
            </button>
        </div>
        <!-- Not displayed: the server is chosen through the status button. Kept for landing.js. -->
        <button id="server_selection_button" tabindex="-1"><%- lang('landing.launchButtonPlaceholder') %></button>
        <div id="mojangStatusWrapper">
            <span id="mojang_status_icon">&#8226;</span>
            <div id="mojangStatusEssentialContainer"></div>
            <div id="mojangStatusNonEssentialContainer"></div>
        </div>
    </div>

    <!-- News window -->
    <div id="newsContainer" style="display: none;">
        <div id="newsWindow">
            <button id="newsClose" aria-label="<%- lang('landing.newsClose') %>">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
            </button>
            <div id="newsContent" article="-1" style="display: none;">
                <div id="newsStatusContent">
                    <span id="newsHeaderLabel"><%- lang('landing.newsButton') %></span>
                    <a id="newsArticleTitle" href="#">&nbsp;</a>
                    <div id="newsMetaContainer">
                        <span id="newsArticleDate"></span>
                        <span id="newsArticleAuthor"></span>
                        <a id="newsArticleSite" href="#"><%- lang('landing.newsViewOnSite') %></a>
                        <a href="#" id="newsArticleComments"></a>
                    </div>
                </div>
                <div id="newsArticleContainer">
                    <div id="newsArticleContent">
                        <div id="newsArticleContentScrollable">
                            <!-- Article Content -->
                        </div>
                    </div>
                </div>
                <div id="newsNavigationContainer">
                    <button id="newsNavigateLeft" aria-label="<%- lang('landing.newsPrevious') %>">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
                    </button>
                    <span id="newsNavigationStatus"><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                    <button id="newsNavigateRight" aria-label="<%- lang('landing.newsNext') %>">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
                    </button>
                </div>
            </div>
            <div id="newsErrorContainer">
                <div id="newsErrorLoading">
                    <span id="nELoadSpan" class="newsErrorContent"><%- lang('landing.newsErrorLoadSpan') %></span>
                </div>
                <div id="newsErrorFailed" style="display: none;">
                    <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                    <button id="newsErrorRetry"><%- lang('landing.newsErrorRetryButton') %></button>
                </div>
                <div id="newsErrorNone" style="display: none;">
                    <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
                </div>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/landing.js"></script>
</div>
