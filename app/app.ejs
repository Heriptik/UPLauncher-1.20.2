<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/ultra.css">
</head>
<body bkid="<%=bkid%>">
    <div id="ulBg"></div>
    <div id="ulScrim"></div>
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingBackdrop"></div>
        <div id="loadingLogo" class="ulLogo">
            <img src="assets/images/logo.png" alt=""/>
            <div class="ulLogoShine"></div>
        </div>
        <div id="loadingBar">
            <div id="loadingBarTrack"><div id="loadingBarFill"></div></div>
            <span id="loadingText"><%- lang('app.loading') %></span>
        </div>
    </div>
    <!-- Mandatory launcher update (Windows). Shown by uicore.js, released on any failure. -->
    <div id="updateGate" style="display: none;">
        <div id="updateGateLogo" class="ulLogo">
            <img src="assets/images/logo.png" alt=""/>
            <div class="ulLogoShine"></div>
        </div>
        <div id="updateGateBody">
            <span id="updateGateTitle"><%- lang('app.updateGateTitle') %></span>
            <span id="updateGateText"><%- lang('app.updateGatePreparing') %></span>
            <div id="updateGateTrack"><div id="updateGateFill"></div></div>
            <span id="updateGateHint"><%- lang('app.updateGateHint') %></span>
        </div>
    </div>
</body>
</html>
